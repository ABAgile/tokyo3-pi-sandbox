# Copy to .env and replace every CHANGE_ME value. Keep .env private (chmod 600); it is git-ignored.
# Compose reads this file. The Makefile reads SANDBOX_IMAGE, SANDBOX_HOME, SANDBOX_TRUST, SANDBOX_VEILGATE,
# VEILGATED_UID, VEILGATED_GID, and VEILGATED_IMAGE from it.

# Proxy URL for the sandbox. The token is the agent-dev token that `make policy` prints when
# it first seeds etc/clients.json. Form: https://<client-name>:<token>@veilgated-proxy:8080
SANDBOX_PROXY=https://agent-dev:CHANGE_ME_PROXY_TOKEN@veilgated-proxy:8080

# Sandbox image name. `make image` loads the built image under this name.
SANDBOX_IMAGE=ghcr.io/abagile/tokyo3-pi-sandbox:0.1.0

# Project and home mounts for the sandbox: a volume name declared in compose.yml, or an absolute host path.
SANDBOX_PROJ=tokyo3_hq_proj
SANDBOX_HOME=tokyo3_sandbox_home

# Directory inside the SANDBOX_PROJ volume that is mounted at /work for make image and packages.
SANDBOX_SUBPATH=abagile/sandbox

# External volumes for the trust bundle and for veilgated (certificates, policy, auth.json). `make volumes`
# creates them if missing. Any volume name works.
SANDBOX_TRUST=tokyo3_sandbox_trust
SANDBOX_VEILGATE=tokyo3_sandbox_veilgate

# Host paths for the compose.extra.yml overlay. Only needed when that overlay is used.
SANDBOX_PI=
SANDBOX_CHEZMOI=

# Console login for veilgated. Set both: the console listens on a non-loopback address.
VEILGATED_CONSOLE_USERNAME=operator
VEILGATED_CONSOLE_PASSWORD=CHANGE_ME_CONSOLE_PASSWORD

# Optional veilgated settings (defaults shown).
#VEILGATED_IMAGE=ghcr.io/abagile/tokyo3-veilgate:0.2.1
#VEILGATED_PROXY_PORT=8080
#VEILGATED_CONSOLE_PORT=8081
#VEILGATED_LOG_LEVEL=info

# UID:GID that veilgated runs as. It also owns etc/ and lib/ in the veilgate volume.
# Read by compose and by the volumes, certs, and policy targets.
#VEILGATED_UID=65532
#VEILGATED_GID=65532
